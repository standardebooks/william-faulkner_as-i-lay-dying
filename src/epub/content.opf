		<dc:title id="title">As I Lay Dying</dc:title>
		<meta property="file-as" refines="#title">As I Lay Dying</meta>
		<dc:subject id="subject-1">Mississippi -- Fiction</dc:subject>
		<dc:subject id="subject-2">Burial -- Fiction</dc:subject>
		<dc:subject id="subject-3">Death -- Fiction</dc:subject>
